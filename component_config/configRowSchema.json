{
  "type": "object",
  "title": "CrewAI Agentic Flow Configuration",
  "required": [
      "crewai_metadata"
  ],
  "properties": {
    "crew_template": {
      "type": "string",
      "title": "CrewAI Template",
      "description": "You can load predefined templates to get started with your crew.",
      "propertyOrder": 1,
      "enum": [
        "empty_template",
        "dummy_template"
      ],
      "options": {
        "enum_titles": [
          "Empty Template with predefined structure",
          "Dummy Template, run it to test the component"
        ]
      }
    },
    "load_template": {
      "type": "button",
      "format": "sync-action",
      "propertyOrder": 2,
      "options": {
        "async": {
          "label": "LOAD TEMPLATE",
          "action": "loadTemplate"
        }
      }
    },
    "crewai_metadata": {
      "type": "object",
      "title": "CrewAI Metadata",
      "propertyOrder": 3,
      "required": [
          "flows",
          "agents",
          "tasks"
      ],
      "properties": {
        "flows": {
          "type": "string",
          "title": "Flows",
          "description": "YAML definition of flows.",
          "format": "editor",
          "options": {
            "editor": {
              "mode": "text/x-yaml",
              "lineNumbers": true
            }
          },
          "propertyOrder": 10
        },
        "agents": {
          "type": "string",
          "title": "Agents",
          "description": "YAML definition of agents.",
          "format": "editor",
          "options": {
            "editor": {
              "mode": "text/x-yaml",
              "lineNumbers": true
            }
          },
          "propertyOrder": 20
        },
        "tasks": {
          "type": "string",
          "title": "Tasks",
          "description": "YAML definition of tasks.",
          "format": "editor",
          "options": {
            "editor": {
              "mode": "text/x-yaml",
              "lineNumbers": true
            }
          },
          "propertyOrder": 30
        },
        "validate_config_yamls": {
          "type": "button",
          "format": "sync-action",
          "propertyOrder": 40,
          "options": {
            "async": {
              "label": "VALIDATE CONFIGURATION YAMLs",
              "action": "validate_config_yamls"
            }
          }
        }
      }
    },
    "debug": {
      "type": "boolean",
      "title": "Enable Debug Mode",
      "format": "checkbox",
      "default": false,
      "propertyOrder": 4
    }
  }
}